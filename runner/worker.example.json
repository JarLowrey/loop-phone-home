{
  "_comment": "Copy to worker.json and fill in. Relative paths are relative to this file's folder. The worker runner reads the keys in worker_task.py DEFAULTS; the driver reads those in driver/loop_common.py CONFIG_DEFAULTS.",
  "project_root": "/path/to/your/git/repo",
  "tasks_file": "loop/TASKS.md",
  "logs_dir": "loop/logs",
  "inbox_seen_file": "loop/inbox-seen.txt",
  "topic_file": "~/.claude/hooks/ntfy-topic.txt",
  "token_file": "~/.claude/hooks/ntfy-token.txt",
  "inbox_topic_suffix": "",
  "scope": [
    "src/",
    "tests/"
  ],
  "test_command": [
    "python",
    "tests/run.py"
  ],
  "totals_marker": "passed, ",
  "pass_marker": " 0 failed",
  "failure_regex": "FAIL (\\w+)",
  "test_count_glob": "tests/**/test_*.py",
  "test_count_marker": "def test_",
  "project_rules": "Follow the project's style guide. Use the existing patterns in the code.",
  "system_prompt": "You are a coding agent. Read only the files the task names, and search with Grep before opening anything large.",
  "worker_model": "your-local-model-name",
  "model_server": "http://localhost:11434",
  "claude_exe": "claude",
  "helper_model": "haiku",
  "max_assists": 2,
  "max_minutes": 60,
  "progress_interval": 600,
  "early_progress_interval": 240,
  "stuck_check_interval": 210,
  "loop_idle_minutes": 15,
  "max_review_rounds": 2,
  "review_references": [
    "CLAUDE.md",
    "docs/DESIGN.md"
  ],
  "deny_tools": [
    "Bash(git restore:*)",
    "Bash(git checkout:*)",
    "Bash(git reset:*)",
    "Bash(git stash)",
    "Bash(git stash push:*)",
    "Bash(git stash save:*)",
    "Bash(git stash pop:*)",
    "Bash(git stash apply:*)",
    "Bash(git stash drop:*)",
    "Bash(git stash clear:*)",
    "Bash(git clean:*)",
    "Bash(git rm:*)",
    "Bash(git mv:*)",
    "Bash(git switch:*)",
    "Bash(git add:*)",
    "Bash(git commit:*)"
  ],
  "phone_titles": [
    "Worker may be stuck",
    "Worker blocked",
    "Worker model error",
    "Worker hand-off error",
    "Worker run not started"
  ],
  "notify_all": false,
  "usage_log": "usage.jsonl",
  "loop_file": "loop/LOOP.md",
  "progress_file": "loop/PROGRESS.md",
  "open_task_pattern": "^### \\[ \\] (\\S+) (.*)$",
  "rules_file": "CLAUDE.md",
  "project_brief": "a software project",
  "sync": false,
  "task_model": "sonnet",
  "task_turns": 60,
  "task_timeout": 1800,
  "test_timeout": 1800,
  "test_function_regex": "^\\s*(?:async\\s+)?(?:static\\s+)?(?:def|func|function|fn)\\s+(test_?\\w+)\\s*\\(",
  "any_function_regex": "^\\s*(?:async\\s+)?(?:static\\s+)?(?:def|func|function|fn)\\s+(\\w+)\\s*\\(",
  "assert_regex": "\\bassert\\w*\\b|\\bexpect\\s*\\(|\\bfail\\s*\\(",
  "design_file": "",
  "fail_markers": [],
  "test_one_hint": "",
  "test_files": [
    "tests/**/test_*.py"
  ],
  "files_prefix": "",
  "files_strip": [],
  "slots_dir": "",
  "slot_files": {},
  "cache_dirs": [],
  "monitor_command": [],
  "task_id_regex": "\\b([A-Z][A-Z0-9]*-[A-Z0-9]+[a-z]?)\\b",
  "review_id_regex": "-(?:R|V\\d+)$"
}
